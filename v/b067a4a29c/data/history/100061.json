],[2],[],[],[]],"pit":[[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[]],"sc":[],"vsc":[],"red":[],"fl":null,"best":[],"xl":[],"bx":[],"s0":[780000,1020000,1080000,240000,1140000,540000,960000,840000,480000,1200000,660000,420000,300000,1260000,1320000,900000,600000,120000,0,360000,60000,180000,720000],"nar":[{"lap":0,"text":"The start was set at eight in the morning when the cars started individually at intervals of one minute in order of their race numbers.","q":true,"src":"goldenera.fi"},{"lap":1,"text":"Morandi leads after one lap in 39m05s from Marano, Ghersi, Varzi and Fisauli, all within a minute.","q":false,"c":0},{"lap":1,"text":"Borzacchini was not involved in the fight for first position and ended up in twelfth place, heading for the pits.","q":true,"src":"goldenera.fi","c":15},{"lap":2,"text":"On the second lap Morandi (OM) made another fast round in 38m39s, retaining the lead after 1h17m44s. Ghersi followed after 1m21s, Varzi after 1m55s, at 2m02s by Rosa and at 2m07s by Magistri.","q":true,"src":"goldenera.fi","c":0},{"lap":2,"text":"Cucinotta sets the second-best lap time, 39m14s, and moves up to seventh.","q":false,"c":9},{"lap":2,"text":"Three retirements occurred on the second lap, Finocchiaro (Fiat), Rallo (Salmson) and Ruggeri (Bugatti), the latter due to a broken water pipe.","q":true,"src":"goldenera.fi","c":22},{"lap":3,"text":"Morandi laps in 38m25s and leads after three laps in 1h56m09s; Ghersi is second.","q":false,"c":0},{"lap":3,"text":"Vittoria withdraws with misfiring and Costantino retires; 18 cars remain.","q":false},{"lap":4,"text":"Varzi passed Ghersi for second place but was now almost five minutes behind the leader.","q":true,"src":"goldenera.fi","c":2},{"lap":4,"text":"By the end of the fourth lap Cassata (Fiat), Pietroburgo (Aurea) and Borzacchini (Maserati) retired, the latter due to carburetor failure","q":true,"src":"goldenera.fi","c":15},{"lap":5,"text":"Rosa regained lost time and overtook Ghersi and Varzi, moving into second place.","q":true,"src":"goldenera.fi","c":1},{"lap":5,"text":"Rosa (OM) and the Alfa Romeos of Varzi, Magistri and Ghersi were separated from each other only by a few seconds.","q":true,"src":"goldenera.fi"},{"lap":5,"text":"Meanwhile, Marano overtook Cucinotta for sixth place behind Ghersi.","q":true,"src":"goldenera.fi","c":5},{"lap":6,"text":"Morandi leads by 6m44s after six laps; Rosa is second, 48 seconds ahead of Varzi.","q":false,"c":0},{"lap":6,"text":"Marano maintained the sixth position, reducing the gap from Magistri to 11 seconds.","q":true,"src":"goldenera.fi","c":5},{"lap":6,"text":"Cucinotta drops to tenth with engine problems.","q":false,"c":9},{"lap":6,"text":"Pirandello (OM) and Zingarelli (Auburn) were forced to retire due to mechanical failures, with the field down to 13 cars after six laps.","q":true,"src":"goldenera.fi"},{"lap":7,"text":"At the end of lap seven the two OMs dominated the race.","q":true,"src":"goldenera.fi","c":0},{"lap":8,"text":"On lap eight, Morandi slowed down a little, as he did not want to run the risk of losing a certain victory.","q":true,"src":"goldenera.fi","c":0},{"lap":8,"text":"After crossing the finish line, Morandi suffered a tire blow-out.","q":true,"src":"goldenera.fi","c":0},{"lap":8,"text":"Morandi wins; Rosa makes it an OM one-two, Varzi third and Ghersi fourth, winning the 1500 class.","q":false,"c":0}]}