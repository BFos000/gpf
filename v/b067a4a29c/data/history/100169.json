,[[3,null,"report"]],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[]],"sc":[],"vsc":[],"red":[],"fl":[2,3,827000],"best":[[2,3,827000]],"xl":[],"bx":[],"s0":[1200000,240000,1440000,240000,240000,240000,240000,240000,480000,240000,960000,240000,480000,0,240000,0,480000,0,1200000,960000,240000,720000,720000,720000,240000,1200000,240000,240000,240000,960000,240000,240000],"nar":[{"lap":0,"text":"Premoli Rocco and Minucci did not start which left 19 cars to line up on the grid","q":true,"src":"goldenera.fi"},{"lap":0,"text":"At 3:40 PM Miss Letta, the young daughter of the Prefect of Livorno, gave the signal to start. Tuffanelli and Minozzi led the way, then Cornaggia and Trossi, all from the first row.","q":true,"src":"goldenera.fi","c":17},{"lap":0,"text":"Varzi in the fourth row stalled the engine and was delayed for about ten seconds.","q":true,"src":"goldenera.fi","c":0},{"lap":0,"text":"After an interval of four minutes the 1100 class was started, with Malaguti in front, followed by Mallucci and Magretti.","q":true,"src":"goldenera.fi","c":1},{"lap":1,"text":"After the 1st lap, great applause welcomed Nuvolari who covered the 20 km in 14m23s at 85.410 km/h average speed. He was five seconds ahead of Trossi in 14m28s","q":true,"src":"goldenera.fi","c":4},{"lap":1,"text":"Varzi, having passed 12 cars, is sixth after his delayed start; Danese retires with a broken connecting rod.","q":false,"c":0},{"lap":2,"text":"Nuvolari completed his second lap in 13m54s increasing his lead, but Trossi was no longer second as he had slowed with a supercharger problem.","q":true,"src":"goldenera.fi","c":6},{"lap":2,"text":"Moll is second, 19 seconds behind Nuvolari; Aldrighetti retires.","q":false,"c":2},{"lap":3,"text":"Moll laps in 13m47s and is six seconds behind Nuvolari; Barsotti and Lami retire.","q":false,"c":2},{"lap":3,"text":"In the 1100 class Chambost has caught Malaguti; both are on 49m03s.","q":false,"c":20},{"lap":4,"text":"On the 4th lap Moll passed Nuvolari and was 3 seconds ahead of the Mantuan at the end of the lap. But it was Varzi who amazed everyone; in one lap he took 13 seconds from Nuvolari.","q":true,"src":"goldenera.fi","c":2},{"lap":5,"text":"On the 5th lap, Nuvolari managed a lap in 13m57s and recaptured the lead. By the end of the lap he was 11 seconds ahead of Moll, who had a time of 14m11s.","q":true,"src":"goldenera.fi","c":4},{"lap":5,"text":"Balestrero and della Chiesa retire at their pits; Chambost's Salmson is out of the 1100 race.","q":false,"c":19},{"lap":6,"text":"Moll leads Nuvolari by 21 seconds; Nuvolari signals a front axle problem and too much play in the steering.","q":false,"c":4},{"lap":6,"text":"Farina in 7th place had two contacts with crash barriers without serious consequences and was recovering lost ground.","q":true,"src":"goldenera.fi","c":10},{"lap":7,"text":"There were now 35 seconds between Moll and Varzi, the latter had passed Nuvolari for second place.","q":true,"src":"goldenera.fi","c":0},{"lap":8,"text":"Malaguti wins the 1100 class in 2h09m39.2s from Matrullo, Mallucci, Toti, Nenzioni and Corrado.","q":false,"c":1},{"lap":8,"text":"Moll drove his 8th lap in 14m06s but Varzi drove his in 13m59s, so now there was only 28 seconds between them.","q":true,"src":"goldenera.fi","c":0},{"lap":9,"text":"Varzi, 23 seconds behind, signals tyre worries but chooses to ease off rather than stop.","q":false,"c":0},{"lap":10,"text":"Moll stops with a buckled left rear wheel; it is changed in 18 seconds but Varzi goes by and leads by 12 seconds.","q":false,"c":2},{"lap":10,"text":"To shouts of enthusiasm and thunderous applause, Varzi arrived and passed into the lead.","q":true,"src":"goldenera.fi","c":0},{"lap":12,"text":"At the end of the 12th lap Varzi crossed the finish line as the victor, and Moll followed nine seconds later. Nuvolari finished in third place, Trossi was fourth, Barbieri fifth, Farina sixth and Magistri seventh.","q":true,"src":"goldenera.fi","c":0}]}