"goldenera.fi"},{"lap":1,"text":"When the starting lights came on, Carlo Cazzaniga took off like a rocket in his Bugatti grabbing the immediate lead.","q":true,"src":"goldenera.fi","c":20},{"lap":1,"text":"Birkin leads at the end of the first lap from Nuvolari and Campari.","q":false,"c":2},{"lap":1,"text":"Varzi's Bugatti runs on seven cylinders: the sump was overfilled with oil.","q":false,"c":0},{"lap":2,"text":"Fagioli pits for a plug change.","q":false,"c":19},{"lap":5,"text":"Campari takes the lead from Birkin.","q":false,"c":17},{"lap":5,"text":"After five laps Campari leads in 22m58s, Birkin 9 seconds behind, Nuvolari 5 seconds further back, then Varzi, Zehender and Fagioli.","q":false,"c":17},{"lap":10,"text":"Campari leads after 10 laps at about 107 mph; Nuvolari has got ahead of Birkin, who is only a few yards behind.","q":false,"c":17},{"lap":14,"text":"Campari pits; his oil tank is coming adrift and is lashed with rope. Nuvolari takes the lead.","q":false,"c":17},{"lap":15,"text":"At half distance Nuvolari leads in 1h09m, Birkin 10 seconds behind, Varzi 19; Campari and Zehender follow at two-minute intervals.","q":false,"c":1},{"lap":16,"text":"Birkin stops to refuel; Campari and Zehender slip by while he is stationary.","q":false,"c":2},{"lap":16,"text":"Birkin burns his arm on the exhaust pipe during the stop.","q":false,"c":2},{"lap":18,"text":"Campari stops again for his loose oil tank; after 15 minutes he restarts.","q":false,"c":17},{"lap":20,"text":"At 20 laps Nuvolari still led, but Varzi was now right on his tail.","q":true,"src":"goldenera.fi","c":1},{"lap":21,"text":"Campari retires; the lack of oil has wrecked the Maserati's engine.","q":false,"c":17},{"lap":23,"text":"Nuvolari pits for fuel: 20 seconds stationary, about a minute lost in all. Varzi leads.","q":false,"c":1},{"lap":23,"text":"Varzi's Bugatti carries an additional fuel tank; he plans to run non-stop.","q":false,"c":0},{"lap":25,"text":"Varzi leads Nuvolari by 20 seconds.","q":false,"c":0},{"lap":26,"text":"On the next lap he drove like a demon and caught up the Bugatti.","q":true,"src":"goldenera.fi","c":1},{"lap":27,"text":"Varzi has trouble switching to his spare tank and Nuvolari closes in.","q":false,"c":0},{"lap":29,"text":"Nuvolari passes the stands in the lead at the end of lap 29.","q":false,"c":1},{"lap":29,"text":"They entered the last lap almost deal even and stayed that way well into the lap.","q":true,"src":"goldenera.fi"},{"lap":30,"text":"Varzi brakes later into the last turn and uses the slipstream to win by a whisker from Nuvolari.","q":false,"c":0},{"lap":30,"text":"Birkin finishes third, Battilana fourth.","q":false,"c":2},{"lap":30,"text":"Zehender had the misfortune to retire on his last lap.","q":true,"src":"goldenera.fi","c":14}]}