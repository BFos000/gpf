,null,"data"],[193,35000,"data"]],[],[[8,120000,"data"]],[],[[138,480000,"data"]],[]],"sc":[],"vsc":[],"red":[],"fl":null,"best":[],"xl":[],"bx":[],"nar":[{"lap":0,"text":"Due to rain in the morning, the start of the race was delayed for 11:30 AM and the distance was reduced from 350 to 200 laps and from 700 to 400 km.","q":true,"src":"goldenera.fi"},{"lap":0,"text":"Federico \"Frick\" Armangu\u00e9, the Director of the Autodrome, drove the pilot car, a superb Hispano-Suiza, for the rolling start.","q":true,"src":"goldenera.fi"},{"lap":1,"text":"After the first lap Resta was in the lead followed by Zborowski, Divo, Gallop, Mora, Carreras and Feliu.","q":true,"src":"goldenera.fi","c":5},{"lap":4,"text":"On the fourth lap, Divo passed Zborowski and completed the first five laps in 3m29s at 175.610 km/h average speed.","q":true,"src":"goldenera.fi","c":0},{"lap":6,"text":"The smaller Aston Martin and Elizalde were admired for keeping up with the 2000 cc cars.","q":true,"src":"goldenera.fi"},{"lap":8,"text":"The Diatto of Mora stopped at the pits to repair a breakdown in two minutes.","q":true,"src":"goldenera.fi","c":3},{"lap":9,"text":"On lap 9, Zborowski had just taken the lead when he was passed by Resta. Feliu in the Elizalde fell one lap behind.","q":true,"src":"goldenera.fi","c":1},{"lap":12,"text":"On lap 12, Divo passed the Count, then Resta for the lead with Gallop's Aston Martin in 4th place.","q":true,"src":"goldenera.fi","c":0},{"lap":18,"text":"Zborowski retakes the lead.","q":false,"c":1},{"lap":21,"text":"Divo passes Zborowski for the lead.","q":false,"c":0},{"lap":23,"text":"Then Resta passed Zborowski and the leading Divo, with the Count in third place.","q":true,"src":"goldenera.fi","c":5},{"lap":26,"text":"The constant lead changes continued in the battle waged between Divo, the Count and Resta.","q":true,"src":"goldenera.fi","c":1},{"lap":28,"text":"After two more laps the Count was again in the lead","q":true,"src":"goldenera.fi","c":1},{"lap":40,"text":"The drivers seldom exceeded a speed of 135 km/h.","q":true,"src":"goldenera.fi"},{"lap":46,"text":"On lap 46, the order was Resta, Divo and Zborowski.","q":true,"src":"goldenera.fi","c":5},{"lap":49,"text":"On lap 49 Divo attacked and passed Resta. Then Zborowski also passed Resta, chasing after Divo.","q":true,"src":"goldenera.fi","c":0},{"lap":50,"text":"After 50 laps, Resta again took the lead after 44m27s.","q":true,"src":"goldenera.fi","c":5},{"lap":54,"text":"On lap 54, as Divo stopped to change a wheel, Zborowski took the lead, and began a serious fight as he was now driving faster.","q":true,"src":"goldenera.fi","c":1},{"lap":57,"text":"On lap 57, Divo had regained third place.","q":true,"src":"goldenera.fi","c":0},{"lap":65,"text":"Zborowski pits for a wheel; Resta takes the lead from Divo.","q":false,"c":5},{"lap":90,"text":"Towards mid-race, there was a large breakdown of the Aston Martin sitting at his pit and another stop by Divo while the Count marched splendidly in the lead.","q":true,"src":"goldenera.fi","c":6},{"lap":100,"text":"After 100 laps, mid-race, Zborowski led Divo, both in 1h26m19.1s at 139.5 km/h average speed.","q":true,"src":"goldenera.fi","c":1},{"lap":110,"text":"The battle intensified with Resta, Zborowski and Divo alternating the lead, defending themselves in their mutual attacks.","q":true,"src":"goldenera.fi"},{"lap":138,"text":"On lap 138, Resta stopped at the pits, his breakdown seemed to be serious.","q":true,"src":"goldenera.fi","c":5},{"lap":144,"text":"Zborowski stopped on lap 144 as Divo took the lead and gained a lap.","q":true,"src":"goldenera.fi","c":0},{"lap":150,"text":"After 150 laps, Divo led in 2h05m02s at 144 km/h average speed.","q":true,"src":"goldenera.fi","c":0},{"lap":155,"text":"As Zborowski covered the laps in 42 seconds, Divo fell behind.","q":true,"src":"goldenera.fi","c":1},{"lap":160,"text":"Resta eventually resumed, but had lost about eight minutes in his pit.","q":true,"src":"goldenera.fi","c":5},{"lap":167,"text":"Resta's breakdown on lap 167 was serious and caused his retirement.","q":true,"src":"goldenera.fi","c":5},{"lap":167,"text":"Gallop retires the Aston Martin.","q":false,"c":6},{"lap":180,"text":"The latter did his best to stick to his pace but the Count now increasingly pulled away.","q":true,"src":"goldenera.fi","c":1},{"lap":193,"text":"On lap 193, Zborowski destroyed a tire and changed the wheel in only 35 seconds.","q":true,"src":"goldenera.fi","c":1},{"lap":193,"text":"Divo had seen the Count's dilemma and increased his pace in the hope to gain a good advantage.","q":true,"src":"goldenera.fi","c":0},{"lap":200,"text":"Divo wins by 50 seconds from Zborowski's Miller.","q":false,"c":0}]}