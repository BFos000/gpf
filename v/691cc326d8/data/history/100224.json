28000,"data"],[45,null,"data"],[46,167000,"data"]],[],[[12,null,"data"]],[],[[1,null,"data"]]],"sc":[],"vsc":[],"red":[],"fl":[0,14,179600],"best":[[0,14,179600]],"xl":[],"bx":[],"nar":[{"lap":0,"text":"Despite the warm weather, the number of spectators was visibly less than in previous years.","q":true,"src":"goldenera.fi"},{"lap":0,"text":"It was a very hot summer day. Grid positions had been decided by practice times and the cars were lined up accordingly, although practice times were released for only six drivers.","q":true,"src":"goldenera.fi"},{"lap":1,"text":"When the Propaganda Minister Dino Alfieri lowered the flag at 11:00 AM, Stuck immediately shot into the lead followed by Nuvolari, Rosemeyer, Varzi and Delius.","q":true,"src":"goldenera.fi","c":10},{"lap":1,"text":"When the cars completed the first lap, Stuck was still in the lead, 50 meters ahead of Nuvolari, with Rosemeyer right behind.","q":true,"src":"goldenera.fi","c":10},{"lap":1,"text":"Ghersi pits with defective plugs.","q":false,"c":11},{"lap":2,"text":"After the second lap Stuck was still leading but Rosemeyer had moved into second place ahead of Nuvolari followed after six seconds by Varzi while the remaining field broke up.","q":true,"src":"goldenera.fi","c":0},{"lap":3,"text":"Stuck extends his lead with a 3m05s lap; Delius takes fourth from Varzi. Ghersi retires with engine trouble.","q":false,"c":10},{"lap":4,"text":"By the end of lap 4, Rosemeyer had taken the lead with a lap in3m03s at 137.104 km/h average speed. He was 3 seconds ahead of Stuck and 8 seconds ahead of Nuvolari.","q":true,"src":"goldenera.fi","c":0},{"lap":8,"text":"On lap 8 Nuvolari drove a record lap in 3m2.2s at 138.309 km/h average speed and he passed Stuck for second place to frantic applause from the spectators, but he was still eight seconds behind Rosemeyer.","q":true,"src":"goldenera.fi","c":1},{"lap":11,"text":"On lap 11 Rosemeyer drove a new record lap in 3m01.4s at 138.765 km/h average speed.","q":true,"src":"goldenera.fi","c":0},{"lap":12,"text":"Varzi pits with a loss of power and refuses to continue; Hasse takes over after about six minutes, two laps down.","q":false,"c":9},{"lap":13,"text":"Nuvolari answers with a lap in 3m flat.","q":false,"c":1},{"lap":14,"text":"Rosemeyer laps in 2m59.6s.","q":false,"c":0},{"lap":15,"text":"After 15 laps Farina had passed Dreyfus","q":true,"src":"goldenera.fi"},{"lap":16,"text":"The Varzi/Hasse Auto Union, trailing smoke, retires at the pits.","q":false,"c":9},{"lap":17,"text":"Passing Trossi before the double S-bend, Stuck enters the chicane too fast, hits the curbs and a tree and is thrown out; Trossi and Delius have to stop.","q":false,"c":10},{"lap":17,"text":"Stuck had fallen on the straw bales, he had facial, leg and arm injuries, a concussion and contusions.","q":true,"src":"goldenera.fi","c":10},{"lap":20,"text":"Rosemeyer leads Nuvolari by 13 seconds after 20 laps.","q":false,"c":0},{"lap":24,"text":"On lap 24 Rosemeyer was 15 seconds ahead of Nuvolari.","q":true,"src":"goldenera.fi"},{"lap":29,"text":"On lap 29 Farina stopped at the pits to refuel and change rear tires in 32 seconds.","q":true,"src":"goldenera.fi","c":7},{"lap":30,"text":"Rosemeyer leads Nuvolari by 25 seconds; Biondetti retires with supercharger trouble.","q":false},{"lap":31,"text":"On lap 31 Nuvolari refueled and changed rear wheels in 50 seconds because one wheel locked up and he fell to third place when Delius passed him.","q":true,"src":"goldenera.fi","c":1},{"lap":35,"text":"On lap 35 Rosemeyer stopped at his pit to refuel and change rear tires in 39 seconds.","q":true,"src":"goldenera.fi","c":0},{"lap":36,"text":"Delius loses 5m56s at his stop with a leaking supercharger oil pipe and falls to fifth; Nuvolari is second again.","q":false,"c":2},{"lap":40,"text":"After 40 laps Rosemeyer led Nuvolari by 1m26s","q":true,"src":"goldenera.fi"},{"lap":46,"text":"Farina changes plugs in 2m47s and loses fourth to Delius.","q":false,"c":7},{"lap":48,"text":"Trossi stops for 40 minutes; Bianco takes over and drives very slowly.","q":false,"c":6},{"lap":57,"text":"Farina crashes at a chicane, damaging the rear axle, and retires.","q":false,"c":7},{"lap":59,"text":"Nuvolari refuels and changes rear wheels in 47 seconds.","q":false,"c":1},{"lap":66,"text":"The only change during the remaining laps happened when Delius slowly closed down the gap to Dreyfus and passed him for third place on lap 66.","q":true,"src":"goldenera.fi","c":2},{"lap":72,"text":"Rosemeyer wins, 2m05.3s ahead of Nuvolari; Delius is third, then Dreyfus, Pintacuda, Dusio and Trossi/Bianco.","q":false,"c":0}]}