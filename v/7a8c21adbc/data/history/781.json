,278,289,299,310,319,329,338,347,356,365],[91,119,142,161,179,195,209,223,236,248,260,271,282,292,302,312,321,330,339,347,356],[94,124,148,168,186,203,218,232,246,259,271,282,294,304,315,325,335,344,353,362,371],[93,121,144,164,182,198,213,227,240,253,264,276,287,297,307,317,327,336,345,354],[92,121,144,164,182,198,213,227,240,252,264,275,286,297,307,317,326,336,345,353],[91,119,141,161,178,194,208,222,235,247,259,270,280,290,300,310,319],[92,120,143,163,180,196,211,225,238,250,262,273,284,294],[91,119,142,162,179,195,209,223,236,248,260,271,282],[93,122,145,165,183,199,214,228,241,254,266],[93,122,146,166,184,200,215,229,242,255,267],[91,119,141,161,178,194,209,222,235,247],[88,114,135,154,170,185],[92,120,143,163],[92,120,143],[94,123]],"usd":[81,77,77,78,77,79,79,77,77,79,77,80,78,78,77,78,77,79,79,77,73,78,78,87],"nar":[{"lap":10,"text":"After the car was refuelled, the filler cap, opening forward from his head rest, was snapped off when Behra jumped back into the seat. With the cap retrieved and closed, Behra rejoined in 9th position.","q":true,"src":"Wikipedia","c":5},{"lap":13,"text":"Fangio took his pit stop on lap 13, in first place, and 30 seconds ahead of Hawthorn and Collins.","q":true,"src":"Wikipedia","c":0},{"lap":13,"text":"With Fangio out, the mechanic on the right removed his rear right Centrelock wheel quickly but let the winged nut roll under the car without noticing.","q":true,"src":"Wikipedia","c":0},{"lap":13,"text":"Fangio left the pit lane in third place, and 48 seconds behind Collins who was in second place.","q":true,"src":"Wikipedia","c":0},{"lap":14,"text":"But in his Maserati 250F he began to mount a charge. Over the next 10 laps, Fangio broke and rebroke the lap record 9 times (7 of the records were in successive laps) and he took 15.5 seconds off Hawthorn's lead in the first lap, then another 8.5 seconds in the next lap.","q":true,"src":"Wikipedia","c":0},{"lap":21,"text":"Early in the 21st lap, Fangio went on the inside of the left corner at the ESSO Terrasse taking second place from Collins.","q":true,"src":"Wikipedia","c":0},{"lap":21,"text":"Late in the 21st lap, during a left corner, Fangio cut past Hawthorn on the inside of the corner, with only his right tyres on the track and his left tyres on the grass.","q":true,"src":"Wikipedia","c":0},{"lap":22,"text":"Fangio maintained his lead, but not easily, as Hawthorn fought back, nearly overtaking Fangio at a few corners, but to no avail, and Fangio won the race with about 3 seconds of a lead.","q":true,"src":"Wikipedia","c":0}],"x":{"drivers":[{"id":621,"ref":"england","name":"Paul England","code":null,"nationality":"Australian","dob":"1929-03-28","helmet":null,"seasons":{"1957":{"car":"cooper-climax_1957","source":"history","skills":{"pace":[0.0311,0.5962],"quali":[0.0783,0.4339]}}}},{"id":601,"ref":"gibson","name":"Dick Gibson","code":null,"nationality":"British","dob":"1918-04-16","helmet":null,"seasons":{"1957":{"car":"cooper-climax_1957","source":"history","skills":{"pace":[0.2899,0.5],"quali":[0.2899,0.5]}}}}],"cars":[]}}