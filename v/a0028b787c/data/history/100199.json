335616],[790233,1537010,2276780,3016586,3764191,4536768,5367414,6127025,6847196,7578395,8310445,9035756,9839982,10568618,11289353,12118773,12866044,13616562,14364800,15107571],[816172,1584842,2347438,3092151,3845982,4614165,5371611,6131444,6950802,7688376,8410846,9132804,9851636,10575567,11392782,12115603,12833780,13574036,14369246,15142229],[814249,1582581,2346627,3115836,3923227,4699980,5465772,6234013,7211981,7957171,8698783,9425993,10153788,10888798,11622782,12339833,13062966,13784008,14519011,15283177],[847760,1664824,2460967,3248181,4022752,4814837,5822840,6572239,7301557,8038244,8779796,9517976,10421974,11151786,11889242,12628353,13360571,14093190,14821988,15569388],[858584,1697217,2614042,3618610,4378181,5175785,6091990,6819045,7534419,8264569,8977190,9913846,10847379,11610437,12323626,13051632,13762050,14472216,15194775],[783425,1529557,2264248,2994843,3720552,4454556,5185998,5913792,6622582,7317028,8026578,8796182,9496971,10188153,10883409,11760812],[859034,1678993,2488178,3289593,4090429,4898210,5693777,6492005,7286207,8097828,8912644,9646002],[833759,1649405,2519445,3296567,4084382,4891001,5755229,6532386,7298798,8061176],[749189,1475808,2192582,2896025,3592427],[781966,1534031,2279755,3023767],[757178],[]],"f":[[],[],[1],[],[],[],[],[],[],[],[],[],[],[],[12],[],[],[],[],[]],"pit":[[[11,134000,"data"]],[[12,null,"data"]],[[11,67000,"data"]],[[6,null,"data"],[11,75000,"data"],[13,null,"data"],[16,null,"data"]],[[11,47000,"data"]],[[12,null,"data"]],[[11,null,"data"]],[[7,null,"data"],[14,null,"data"]],[[12,null,"data"]],[[9,null,"report"]],[[11,null,"data"]],[[7,null,"data"]],[[1,null,"data"],[5,null,"report"]],[[11,null,"data"]],[],[[2,null,"report"],[7,null,"data"]],[],[],[],[]],"sc":[],"vsc":[],"red":[],"fl":[4,14,632000],"best":[[4,14,632000]],"xl":[],"bx":[],"nar":[{"lap":0,"text":"A short time before the start it stopped raining.","q":true,"src":"goldenera.fi"},{"lap":0,"text":"Nuvolari from the first row shot immediately into the lead, but Caracciola from the third row caught up with him as they passed the pits and led into the S\u00fcdkurve.","q":true,"src":"goldenera.fi","c":2},{"lap":0,"text":"Last to get away were the Auto Unions of Stuck and Pietsch which had both stalled on the grid.","q":true,"src":"goldenera.fi","c":1},{"lap":0,"text":"Varzi in row five, accelerating through the oil smoke, heavy rain and water spray, just missed Stuck's stranded car but grazed the mechanic, who was knocked to the ground and lay there unconscious.","q":true,"src":"goldenera.fi","c":7},{"lap":1,"text":"Caracciola leads lap 1 by 12 seconds from Nuvolari; Fagioli, Rosemeyer and von Brauchitsch close behind.","q":false,"c":2},{"lap":2,"text":"while trying to close up to the German on the second lap, he spun his Alfa at the Bergwerk turn, a sharp uphill right turn, ending backwards on the berm.","q":true,"src":"goldenera.fi","c":0},{"lap":2,"text":"Brivio failed to finish the second lap as the Alfa's differential broke.","q":true,"src":"goldenera.fi","c":18},{"lap":4,"text":"As the road dried, Rosemeyer in second place broke the lap record in 11m35.6s which placed him just 4 seconds behind Caracciola.","q":true,"src":"goldenera.fi","c":3},{"lap":6,"text":"In his chase after Caracciola, Rosemeyer had spun off and slid into the ditch at Breidscheid .","q":true,"src":"goldenera.fi","c":3},{"lap":6,"text":"Chiron retires at the North turn; broken piston.","q":false,"c":16},{"lap":7,"text":"Rosemeyer pits: new right rear wheel, accelerator linkage repaired.","q":false,"c":3},{"lap":7,"text":"The flying Mantuan had made up eight seconds on Brauchitsch and in a bold move went past the German on the outside of the Karussell.","q":true,"src":"goldenera.fi","c":0},{"lap":8,"text":"Von Brauchitsch repasses Nuvolari before D\u00f6ttinger H\u00f6he for third; new lap record 11m16.6s.","q":false,"c":4},{"lap":9,"text":"Nuvolari, von Brauchitsch and Rosemeyer pass Fagioli; Nuvolari is under eight seconds behind Caracciola.","q":false,"c":0},{"lap":10,"text":"There was great excitement at the end of lap 10 because Nuvolari in the old Alfa Romeo had passed Caracciola and was in the lead","q":true,"src":"goldenera.fi","c":0},{"lap":11,"text":"The leaders all pit at the end of lap 11: Nuvolari, Rosemeyer, von Brauchitsch, then Caracciola.","q":false},{"lap":11,"text":"In the excitement Nuvolari's mechanics broke the refueling pump handle and then reverted to pouring the fuel from churns through a large funnel.","q":true,"src":"goldenera.fi","c":0},{"lap":12,"text":"Fagioli leads, then pits at the end of lap 12 for rear wheels and fuel; von Brauchitsch takes the lead.","q":false,"c":5},{"lap":14,"text":"At the beginning of lap 14, Rosemeyer stopped at his pit to attend to the accelerator linkage, which was still binding.","q":true,"src":"goldenera.fi","c":3},{"lap":14,"text":"Von Brauchitsch sets a new fastest lap, 10m32s, and leads Caracciola by 1m30s.","q":false,"c":4},{"lap":14,"text":"Varzi hands the car over to Leiningen.","c":7},{"lap":15,"text":"Nuvolari passes Caracciola for second, 1m37.4s behind von Brauchitsch.","q":false,"c":0},{"lap":17,"text":"Brauchitsch was still in the lead, but was now only 1m13.2s ahead of Nuvolari.","q":true,"src":"goldenera.fi","c":0},{"lap":19,"text":"Von Brauchitsch answers with a fast lap; the lead is back up to 53.2 seconds.","q":false,"c":4},{"lap":20,"text":"When Brauchitsch passed the pits, he pointed to his rear tires; he had seen the breaker strip.","q":true,"src":"goldenera.fi","c":4},{"lap":20,"text":"Stuck passes Caracciola for third.","q":false,"c":1},{"lap":21,"text":"He did not stop at the pits as expected by his shocked team waiting in suspense.","q":true,"src":"goldenera.fi","c":4},{"lap":22,"text":"As his Mercedes went into the Karussell the left rear tire raptured. Von Brauchitsch had continued on the rim only to see the Alfa Romeo pass and win.","q":true,"src":"goldenera.fi","c":4},{"lap":22,"text":"Nuvolari wins by 1m38.6s from Stuck; Caracciola third, Rosemeyer fourth, von Brauchitsch fifth.","q":false,"c":0}]}