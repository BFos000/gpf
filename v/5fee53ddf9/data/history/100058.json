252380,9442423],[1512925,2666408,3822632,4965405,6112025,7256968,8397107,9528354],[1975692,3116374,4252224,5392042,6526027,7676001,8828079,10003376],[1290413,2424148,3560414,4721811,5895547,7057589,8219049,9386624],[1773565,2955489,4146572,5292855,6433281,7571654,8709464,9846418],[2049869,3200642,4351999,5485939,6617342,7884768,9038255,10169521],[1421324,2615640,3788410,4973952,6136767,7306127,8471919,9655380],[1433379,2659837,3881825,5062561,6202126,7341259,8488062,9613736],[1909732,3163705,4395484,5609044,6822789,8031833,9239198,10445508],[1732019,2963775,4192761,5410485,6623286,7852645,9102155,10317403],[1548489,2647749,3733508,4797055,5862880,6915850,7988704,10295816],[1622070,2751828,4257178,5522813,6764982,7987952,9267006,10429486],[2072338,3439279,4775326,6238635,7700315,9159696,10614847,12067358],[1687829,2987205,4305245,5584362,6859543,8131433,9400764],[1415203,2547558,3707986,4846903,5987452,7192596],[1848841,3009251,4321514,5449063,6576676,7691611],[1924892,3097581,4382399,6228588],[1320665,2462886,3608201,4826121],[1862295,3129111,4393276,5636787],[2068621,3404438,4652788,5899694],[1913624,3213953,4462918,5708528],[1527422,2928320,4175966,5421818],[2111177,3256398,4395389],[1264245,2440750,3717073],[2656152,3905971],[1315043,2923878],[1864350],[2286188],[1967721],[2403937],[]],"f":[[5],[],[],[],[2],[],[3,4,5,6,7],[],[],[2,5],[4,5,6,7],[2],[],[1],[4,5,6,7],[4,5,6,7],[6],[],[],[4],[2,4],[3,4],[2,3,4],[3,4],[],[3],[2],[],[1],[],[],[],[]],"pit":[[],[],[[1,null,"report"]],[],[],[],[[2,null,"report"]],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[[1,null,"data"]],[],[],[],[],[],[],[],[],[],[]],"sc":[],"vsc":[],"red":[],"fl":[0,3,1044800],"best":[[0,3,1044800]],"xl":[],"bx":[],"s0":[0,510000,300000,360000,810000,150000,600000,900000,210000,30000,660000,480000,450000,330000,630000,390000,270000,690000,750000,180000,570000,720000,540000,90000,930000,60000,780000,0,420000,870000,840000,960000,240000],"nar":[{"lap":0,"text":"Varzi started first, followed 30 seconds later by Fagioli and every 30 seconds by the driver with the next following race number.","q":true,"src":"goldenera.fi","c":0},{"lap":1,"text":"Varzi leads after the first lap with a lap of 17m24.4s, a new lap record.","q":false,"c":0},{"lap":1,"text":"Borzacchini was second fastest followed by Brilli Peri and Mazzacurati who stopped his Bugatti at the pits.","q":true,"src":"goldenera.fi","c":1},{"lap":1,"text":"Due to a punctured tire Ernesto Maserati headed for his pit to have one wheel changed.","q":true,"src":"goldenera.fi","c":2},{"lap":1,"text":"Filippo Sartorio's Salmson retires.","q":false,"c":32},{"lap":2,"text":"On lap two Varzi had increased his advantage over Borzacchini in second place. Brilli Peri in third position had slightly fallen behind, followed by Ruggeri's Maserati and Ferrari's Alfa.","q":true,"src":"goldenera.fi","c":0},{"lap":2,"text":"Mazzacurati, Viola and Giampietro Nenzioni retire.","q":false},{"lap":2,"text":"Contardo retires in the 1100 cc class.","q":false,"c":31},{"lap":3,"text":"Pugno stopped at the pits to hand his Bugatti over to Alloatti who was supposed to drive the remaining laps.","q":true,"src":"goldenera.fi","c":6},{"lap":3,"text":"Borzacchini is slowed by spark plug trouble; Brilli Peri is just 15 seconds behind him on time.","q":false,"c":1},{"lap":3,"text":"Fagioli was reported to have stopped at the pits to change tires","q":true,"src":"goldenera.fi","c":9},{"lap":3,"text":"In the 1100 category after three laps Castelbarco had moved his Amilcar into the lead while Cattaneo had fallen from first place and was no longer listed.","q":true,"src":"goldenera.fi","c":10},{"lap":3,"text":"Gerolamo Ferrari retires his Lombard.","q":false,"c":27},{"lap":4,"text":"After four laps Varzi still dominated with a time of 1h09m57s. Brilli Peri had passed Borzacchini, who had eased up due to his plug problem.","q":true,"src":"goldenera.fi","c":12},{"lap":4,"text":"When Arcangeli retired his Talbot, the field was down to 17 cars","q":true,"src":"goldenera.fi","c":24},{"lap":5,"text":"Brilli Peri drove an even faster lap than before and reduced Varzi's advantage to 2m16s. Borzacchini was not able to keep up with the faster Talbot.","q":true,"src":"goldenera.fi","c":12},{"lap":5,"text":"After Aymini and Valpreda retired their Delages, the field was down to 15 cars.","q":true,"src":"goldenera.fi"},{"lap":5,"text":"Four Lombards in the 1100 cc class, Moresco, Strobino, Bisighin and Agnelli, are reported to crash out.","q":false},{"lap":6,"text":"After six laps Varzi's advantage over Brilli Peri had increased from 2m13s to 2m34s.","q":true,"src":"goldenera.fi","c":0},{"lap":6,"text":"Nonetheless Maserati had advanced to fourth place, after passing Zanelli's Bugatti and the Alfa Romeos of Ferrari and Ghersi.","q":true,"src":"goldenera.fi","c":2},{"lap":7,"text":"After seven laps Varzi's lead over Brilli Peri had increased to almost three minutes.","q":true,"src":"goldenera.fi","c":0},{"lap":7,"text":"Cortese in the small Bugatti left the road at San Salvatore when he tried to pass another car that had flung a stone smashing half his goggles.","q":true,"src":"goldenera.fi","c":17},{"lap":7,"text":"He broke an arm but his condition was not serious.","q":true,"src":"goldenera.fi","c":17},{"lap":7,"text":"After Enzo Ferrari also retired, the field was down to 13 cars.","q":true,"src":"goldenera.fi","c":16},{"lap":8,"text":"Varzi completes the eight laps in a record 2h20m40.6s.","q":false,"c":0},{"lap":8,"text":"Borzacchini finished second ahead of Ernesto Maserati who was delayed with tire and spark plug changes.","q":true,"src":"goldenera.fi","c":1},{"lap":8,"text":"Brilli Peri had to stop on the last lap less than two kilometers from the finish with a seized gearbox, caused by complete loss of oil.","q":true,"src":"goldenera.fi","c":12},{"lap":8,"text":"Eventually he arrived at the finish, pushing his car, having fallen from second place to 13th.","q":true,"src":"goldenera.fi","c":12},{"lap":8,"text":"Pistarino in the 1100 cc Salmson retired on lap eight.","q":true,"src":"goldenera.fi","c":15}]}