[[10,null,"data"]],[],[[2,180000,"data"]],[],[],[],[],[]],"sc":[],"vsc":[],"red":[],"fl":[0,10,305000],"best":[[0,10,305000]],"xl":[],"bx":[],"nar":[{"lap":0,"text":"A foreboding low rain cloud hung overhead on the overcast sky.","q":true,"src":"goldenera.fi"},{"lap":1,"text":"The cars left in a deafening roar, finally Gaupillat also left after the rest. Pietsch left after a delay of over two minutes.","q":true,"src":"goldenera.fi"},{"lap":1,"text":"Borzacchini leads lap 1 in 5m34s from Czaykowski and Moll; Nuvolari passes nine cars to run fourth.","q":false,"c":1},{"lap":2,"text":"After the second lap Borzacchini still led the race with a lap of 5m16s at 144.843 km/h average speed, leading Nuvolari, Varzi, Lehoux, Czaykowski, Moll, Falchetto and with a slight delay Fagioli.","q":true,"src":"goldenera.fi","c":1},{"lap":3,"text":"At the beginning of the third lap Fagioli made a three minute pit stop because he was losing fuel.","q":true,"src":"goldenera.fi","c":14},{"lap":3,"text":"At the end of lap three Nuvolari, who had been increasing his pace, caught up with Borzacchini, with a lap in 5m16s at 144.843 km/h average speed","q":true,"src":"goldenera.fi","c":0},{"lap":3,"text":"Toselli hands the car over to Joly.","c":5},{"lap":5,"text":"After the fifth lap Nuvolari was in the lead, with a lap time of 5m11s at 147.171 km/h average speed.","q":true,"src":"goldenera.fi","c":0},{"lap":5,"text":"Sommer's race ends after five laps with a broken magneto drive.","q":false,"c":19},{"lap":6,"text":"A major withdrawal took place during the sixth lap when Lehoux retired his Bugatti with a broken piston, even though he had replaced all the pistons just before the race.","q":true,"src":"goldenera.fi","c":18},{"lap":6,"text":"Czaykowski had to give up with a broken oil pump drive on his Bugatti.","q":true,"src":"goldenera.fi","c":17},{"lap":9,"text":"Nuvolari is half a minute ahead of Borzacchini, with Varzi a few seconds further back.","q":false,"c":0},{"lap":9,"text":"Count Premoli abandoned during the ninth lap with a broken second gear in his transmission.","q":true,"src":"goldenera.fi","c":16},{"lap":12,"text":"Varzi retires with a broken drive shaft.","q":false,"c":15},{"lap":12,"text":"After several visits to his pits to change plugs, Fagioli finally gave up after 12 laps with a broken magneto drive","q":true,"src":"goldenera.fi","c":14},{"lap":15,"text":"Brunet retired his Bugatti on lap 15 as did Gaupillat when the oil pressure disappeared in his Bugatti engine due to a cracked sump.","q":true,"src":"goldenera.fi","c":13},{"lap":16,"text":"Villars who had been in fourth position, lost time when he slid off the track in one of the corners and his car got bogged down in a rain-soaked field.","q":true,"src":"goldenera.fi","c":9},{"lap":18,"text":"On lap 18 Nuvolari stopped to refuel for a minute and a half.","q":true,"src":"goldenera.fi","c":0},{"lap":19,"text":"Borzacchini made his refueling stop on lap 19.","q":true,"src":"goldenera.fi","c":1},{"lap":21,"text":"At the beginning of lap 21 Etancelin arrived at the pits pushing his car with a broken differential.","q":true,"src":"goldenera.fi","c":11},{"lap":21,"text":"Waldthausen refuels, then stops just past the grandstands: the fuel cock was left closed. Minutes are lost.","q":false,"c":3},{"lap":24,"text":"Braillard overturned his Bugatti at the Sidi Daoud curve, but was not injured and the car showed no major damage.","q":true,"src":"goldenera.fi","c":10},{"lap":25,"text":"A severe thunderstorm reached the circuit on lap 25 and as had been expected, the weather turned bad with heavy rain and strong winds blowing in raging gusts.","q":true,"src":"goldenera.fi"},{"lap":25,"text":"Villars spins in a sudden shower and overturns his Alfa, losing a great deal of time.","q":false,"c":9},{"lap":25,"text":"The two leading Alfas were circulating in company, just two seconds apart and two laps ahead of Pietsch in third place.","q":true,"src":"goldenera.fi"},{"lap":30,"text":"After 30 laps Nuvolari and Borzacchini share the same time, followed by Pietsch, Zehender, Waldthausen and Moll.","q":false,"c":0},{"lap":33,"text":"Waldthausen catches and passes Pietsch.","q":false,"c":3},{"lap":35,"text":"Borzacchini began to slow down in these last laps, and by lap 35 he had lost 30 seconds to Nuvolari in only 5 laps","q":true,"src":"goldenera.fi","c":1},{"lap":36,"text":"On lap 36 Nuvolari also slowed down but it seemed to the spectators that the battle for first place was unleashed again, when Nuvolari and Borzacchini were fighting side by side","q":true,"src":"goldenera.fi","c":0},{"lap":37,"text":"Nuvolari wins by a fifth of a second from Borzacchini.","q":false,"c":0},{"lap":37,"text":"Zehender takes third, two laps down, after completing the distance; Waldthausen follows three seconds behind in fourth.","q":false,"c":2}]}