3,14,15],[1,2,3,4,6,7],[1,2,3,4,6,7],[1]],"pit":[[[20,null,"data"]],[[20,null,"data"]],[],[],[],[],[],[],[],[],[],[],[],[]],"sc":[],"vsc":[],"red":[],"fl":[0,29,447400],"best":[[0,29,447400]],"xl":[],"bx":[],"nar":[{"lap":0,"text":"Chiron in the first row took the lead right away ahead of Philippe and Zanelli, while de Maleplane's Bugatti was delayed.","q":true,"src":"goldenera.fi","c":0},{"lap":1,"text":"Philippe leads after the first lap in 8m37s, one second ahead of Chiron, with Zanelli at his rear wheel.","q":false,"c":1},{"lap":1,"text":"At the same time clouds approached downloading a formidable amount of rain.","q":true,"src":"goldenera.fi"},{"lap":2,"text":"After the second lap Philippe was still first but Zanelli had passed Chiron for second place.","q":true,"src":"goldenera.fi","c":12},{"lap":2,"text":"Plat\u00e8 ditches his Alfa Romeo and retires.","q":false,"c":13},{"lap":3,"text":"On the third lap the rain increased in intensity making the roads very slippery which resulted in a remarkable change when the daring Zanelli passed Philippe for the lead.","q":true,"src":"goldenera.fi","c":12},{"lap":5,"text":"The rain stopped on lap five when Philippe regained first place after an intense battle with Zanelli.","q":true,"src":"goldenera.fi","c":1},{"lap":5,"text":"It appeared that Chiron intentionally held back and drove a tactically smart race.","q":true,"src":"goldenera.fi","c":0},{"lap":8,"text":"Zanelli is in trouble: one report has steering difficulty, another that his Bugatti turned over.","q":false,"c":12},{"lap":8,"text":"When Bouriat also retired on lap eight, the field was down to 11 cars.","q":true,"src":"goldenera.fi","c":11},{"lap":10,"text":"Philippe leads after ten laps in 1h41m12s, from Chiron and Etancelin.","q":false,"c":1},{"lap":12,"text":"Foresti had stopped at the pits and handed over his car to Zanelli, who was his appointed reserve driver and had retired his own car on lap nine.","q":true,"src":"goldenera.fi","c":9},{"lap":14,"text":"A burst tyre costs Chiron second place and a long delay; Etancelin is now second behind Philippe.","q":false,"c":0},{"lap":15,"text":"After 15 laps, it was still Philippe ahead of Etancelin and Chiron, followed by the battling trio of Lehoux, Bourlier and Broschek.","q":true,"src":"goldenera.fi","c":1},{"lap":16,"text":"On lap 16, Broschek left the road and wrecked his Bugatti, but fortunately without any injuries to himself.","q":true,"src":"goldenera.fi","c":10},{"lap":17,"text":"Philippe covered lap 17 in 8m32s, the fastest lap so far","q":true,"src":"goldenera.fi","c":1},{"lap":18,"text":"Chiron suffered a delay with another puncture but was determined to regain the lost time.","q":true,"src":"goldenera.fi","c":0},{"lap":18,"text":"Chiron laps in 7m57s and passes Etancelin for second.","q":false,"c":0},{"lap":20,"text":"Philippe and Chiron pit for fuel and tyres; Philippe hands his car to Bouriat. Etancelin drives past without stopping.","q":false,"c":1},{"lap":21,"text":"On lap 21 Chiron passed Bouriat and Etancelin for first place. Bouriat in Philippe's car also passed Etancelin to take second place.","q":true,"src":"goldenera.fi","c":0},{"lap":22,"text":"Chiron covered lap 22 in 7m37s at an average of 139.290 km/h, the fastest up until then.","q":true,"src":"goldenera.fi","c":0},{"lap":25,"text":"After 25 laps, it was still Chiron first ahead of Philippe/Bouriat, Etancelin and Lehoux all on the same lap.","q":true,"src":"goldenera.fi","c":0},{"lap":26,"text":"On lap 26, when the Foresti/Zanelli Bugatti retired, the field was down to nine cars.","q":true,"src":"goldenera.fi","c":9},{"lap":29,"text":"Chiron laps in 7m27.4s.","q":false,"c":0},{"lap":29,"text":"Rain returns; Etancelin retires before reaching the finish line.","q":false,"c":8},{"lap":30,"text":"At the end of lap 30 Chiron remained in the lead ahead of Philippe/Bouriat, Lehoux, Dreyfus, Bourlier, de Maleplane, Bouriano and Lepori.","q":true,"src":"goldenera.fi","c":0},{"lap":35,"text":"After 35 laps the classification had not changed.","q":true,"src":"goldenera.fi"},{"lap":36,"text":"On lap 36 Chiron had a rear tire puncture, which helped Philippe and Lehoux, who recovered their lost lap.","q":true,"src":"goldenera.fi","c":0},{"lap":40,"text":"At the end of the race it was still raining and the wet course prevented a final sprint.","q":true,"src":"goldenera.fi"},{"lap":40,"text":"Chiron wins from the Philippe/Bouriat car; Lehoux is third, the first independent.","q":false,"c":0}]}