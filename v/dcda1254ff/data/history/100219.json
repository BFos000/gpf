],"xl":[],"bx":[],"nar":[{"lap":0,"text":"On race day heavy clouds were gathering over Deauville at lunchtime and gusts of chilly wind were blowing.","q":true,"src":"goldenera.fi"},{"lap":0,"text":"Cholmondeley-Tapper had not been able to properly fix the brake drum on the left rear wheel on his Maserati and was a refused to start by the officials.","q":true,"src":"goldenera.fi"},{"lap":0,"text":"At 15:02 Maurice Henry, director of the race, lowered his flag to give the start to the eleven cars.","q":true,"src":"goldenera.fi"},{"lap":1,"text":"Farina was fastest away followed by Lehoux, Sommer, Villapadierna, Wimille and Dreyfus.","q":true,"src":"goldenera.fi","c":5},{"lap":1,"text":"After one lap: Farina, Wimille, Lehoux, Sommer, Dreyfus, Villapadierna, Chambost, Benoist, Martin, Etancelin.","q":false},{"lap":1,"text":"He had taken a corner too fast, hitting a bank damaging the left side of the Dubonnet axle and the left front wheel.","q":true,"src":"goldenera.fi","c":10},{"lap":2,"text":"On the second lap there were changes in the race order as Dreyfus moved up to third place followed by Lehoux, Sommer, Villapadierna, Benoist, Martin and Etancelin.","q":true,"src":"goldenera.fi","c":8},{"lap":2,"text":"He had lost control of his Maserati 8CM and overturned at the Virages des Dunes. An ambulance took Chambost to the local hospital.","q":true,"src":"goldenera.fi","c":9},{"lap":3,"text":"Farina and Wimille were pulling away from the rest, Farina putting in a 1m42.5s lap followed by a lap of 1m41.4s.","q":true,"src":"goldenera.fi","c":5},{"lap":5,"text":"Dreyfus retires to the pit from third with a gearbox failure.","q":false,"c":8},{"lap":8,"text":"By eight laps he had opened up a 17 seconds gap to Wimille","q":true,"src":"goldenera.fi","c":5},{"lap":10,"text":"after 10 laps the gap was 18.3 seconds:","q":true,"src":"goldenera.fi"},{"lap":11,"text":"Benoist makes a pit stop and Martin passes Sommer for fourth.","q":false,"c":1},{"lap":20,"text":"After 20 laps Farina was leading Wimille, who was suffering from a dental abscess and not feeling well, by 25.8 seconds:","q":true,"src":"goldenera.fi","c":5},{"lap":20,"text":"Lehoux, already lapped by Farina, holds third in his 2-litre ERA.","q":false,"c":6},{"lap":29,"text":"After the 29th lap Benoist made a pit stop for new rear tyres and dropped to last.","q":true,"src":"goldenera.fi","c":4},{"lap":30,"text":"After 30 laps Farina was leading Wimille by over a minute:","q":true,"src":"goldenera.fi","c":5},{"lap":32,"text":"Benoist catches Etancelin and passes him for seventh.","q":false,"c":4},{"lap":36,"text":"Farina laps in 1m38.8s.","q":false,"c":5},{"lap":47,"text":"Etancelin retires; his carburettor is stuck wide open.","q":false,"c":7},{"lap":50,"text":"Halfway through the race Farina was leading Wimille by 1m27.5s while Lehoux in third position had been lapped by Wimille.","q":true,"src":"goldenera.fi"},{"lap":53,"text":"On the 53rd lap Farina stopped for refuelling. The stop took 53 seconds and Farina rejoined the race 22 seconds in front of Wimille.","q":true,"src":"goldenera.fi","c":5},{"lap":53,"text":"Lehoux's stop is slowed when fuel is spilled on his seat; he drops to fifth. Villapadierna and Martin also refuel.","q":false,"c":6},{"lap":57,"text":"After 57 laps the gap was down to three seconds","q":true,"src":"goldenera.fi","c":0},{"lap":58,"text":"Wimille passes Farina on the Boulevard Eug\u00e8ne Cornuch\u00e9 to take the lead.","q":false,"c":0},{"lap":61,"text":"After 61 laps Wimille made his refuelling stop losing over half a lap to Farina","q":true,"src":"goldenera.fi","c":0},{"lap":62,"text":"Trying to lap Lehoux, Farina touches the ERA; both cars roll over and Lehoux's car catches fire. Both drivers are taken to hospital.","q":false,"c":5},{"lap":64,"text":"On the 64th lap the accelerator on Benoist's Bugatti got stuck and he crashed into the sandbags in a corner.","q":true,"src":"goldenera.fi","c":4},{"lap":64,"text":"There were now only four competitors left with Wimille leading by over a lap from Sommer.","q":true,"src":"goldenera.fi"},{"lap":72,"text":"On the 72nd lap Sommer retired with a broken rear axle leaving only three competitors:","q":true,"src":"goldenera.fi","c":3},{"lap":80,"text":"Wimille eases off to 1m47s laps.","q":false,"c":0},{"lap":100,"text":"Wimille wins; Martin is second, with Villapadierna third, flagged off after 98 laps.","q":false,"c":0}]}