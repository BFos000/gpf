0998,23819400],[9811571,16196457,23230135],[8889722,16630776],[7365587,14024493],[11181904],[9220726],[8116881],[10190090],[7082990],[8006288],[7363678],[10659988],[],[],[],[]],"f":[[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[1,2],[],[],[],[],[],[],[],[],[],[],[],[]],"pit":[[[1,null,"data"],[2,null,"data"],[3,null,"data"]],[],[],[],[[2,null,"data"]],[[2,null,"data"]],[[2,null,"data"]],[[2,null,"data"]],[],[[1,null,"data"],[3,null,"data"]],[],[],[[2,null,"data"]],[],[],[],[],[],[],[[1,null,"data"],[3,null,"data"]],[],[],[],[[3,600000,"report"]],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[]],"sc":[],"vsc":[],"red":[],"fl":null,"best":[],"xl":[],"bx":[[0,1,5857800]],"s0":[4320000,1320000,1800000,3720000,480000,4080000,3120000,4200000,3840000,4560000,4800000,2640000,4680000,600000,1920000,3960000,2040000,2760000,4920000,1080000,2400000,240000,2520000,2280000,3000000,120000,3360000,3480000,1560000,720000,3600000,1680000,840000,3240000,360000,1440000,960000,4440000,0,2880000,2160000,1200000],"nar":[{"lap":0,"text":"At 6:00 AM the sky was covered and it was cool when the cars lined up, ready for the race.","q":true,"src":"goldenera.fi"},{"lap":0,"text":"The cars started individually in order of race numbers at intervals of two minutes and the same interval between categories.","q":true,"src":"goldenera.fi"},{"lap":1,"text":"At the end of the first lap Masetti (Mercedes) was in the lead after 1h37m37.8s. His most serious opponent was Goux (Ballot) who followed over two minutes behind","q":true,"src":"goldenera.fi","c":0},{"lap":1,"text":"Scheef (Mercedes) had driven over a large dog that ran between his wheels, causing the car to spin off the road into a ditch. Two wheels were broken but after twenty minutes he had the car back on the road.","q":true,"src":"goldenera.fi","c":19},{"lap":2,"text":"At the beginning of the second lap Masetti stopped to repair the tightening belt of the hood that had torn apart and refueled, losing five minutes.","q":true,"src":"goldenera.fi","c":0},{"lap":2,"text":"Minoia stops for 36 minutes to repair an ignition defect.","q":false,"c":36},{"lap":2,"text":"Meregalli (Diatto) crashed after 37 kilometers, when he took a slow turn at much too high a speed, ran off the road and overturned.","q":true,"src":"goldenera.fi","c":35},{"lap":2,"text":"His riding mechanic Giuseppe Giacchino is killed; Meregalli is badly injured.","q":false,"c":35},{"lap":2,"text":"News arrived that Nazzaro B. (Fiat) had crashed near Polizzi but escaped with minor injuries.","q":true,"src":"goldenera.fi","c":37},{"lap":2,"text":"At the end of the second lap, Goux held the lead ahead of Masetti, followed by Giacone (Fiat), Sailer (Mercedes), Foresti (Ballot) and Ascari (Alfa Romeo).","q":true,"src":"goldenera.fi","c":1},{"lap":3,"text":"Sailer spins into a deep ditch in a sharp left turn but rejoins, losing time.","q":false,"c":5},{"lap":3,"text":"After 324 km Goux in the Ballot held a two-minute lead","q":true,"src":"goldenera.fi","c":1},{"lap":4,"text":"Goux's rear brakes are nearly gone; he runs into a ditch, breaking a frame member and holing the radiator, but still leads.","q":false,"c":1},{"lap":4,"text":"Goux changes a burst front tyre; his rear tyres are worn down to the red layer.","q":false,"c":1},{"lap":4,"text":"Between Cerda and Caltavutura Brilli-Peri had followed in Sailer's dust cloud when he did not see one corner, overturned his car and escaped with minor injuries.","q":true,"src":"goldenera.fi","c":27},{"lap":4,"text":"News was then announced from Caltavuturo that Goux and Masetti had arrived at the same time in 5h34m which resulted in a wave of enthusiasm.","q":true,"src":"goldenera.fi","c":0},{"lap":4,"text":"Goux arrives first on the road; then the red Mercedes of Masetti, the winner.","q":false,"c":0}]}