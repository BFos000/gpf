],[1,2],[1,2],[1,2],[1,2],[1,2],[1],[],[],[],[]],"pit":[[[6,720000,"data"]],[],[[3,null,"data"]],[],[],[],[],[],[],[[6,null,"report"]],[],[],[],[],[],[],[],[[3,null,"data"]],[],[],[],[[1,null,"data"]],[],[],[],[],[],[],[],[],[],[]],"sc":[],"vsc":[],"red":[],"fl":null,"best":[],"xl":[],"bx":[[6,1,3145500]],"s0":[180000,1080000,900000,1350000,90000,720000,360000,1980000,2340000,450000,1440000,990000,2160000,270000,540000,2700000,2610000,1170000,1890000,2430000,2070000,810000,1710000,2970000,1800000,1260000,630000,2520000,0,1530000,1620000,2250000],"nar":[{"lap":0,"text":"The starting order had been decided by ballot. The cars were sent away at 1\u00bd-minute intervals.","q":true,"src":"goldenera.fi"},{"lap":1,"text":"Fabry (8B Itala) took a corner too fast at Vibraye and his wheels collapsed causing him to topple over.","q":true,"src":"goldenera.fi","c":29},{"lap":1,"text":"Le Blon runs off the wooden road at St. Calais and crashes; he and his mechanic start repairing the buckled rear wheel.","q":false,"c":21},{"lap":1,"text":"Civelli de Bosch, held to 30 km/h by his unfinished Gr\u00e9goire, retires; Hanriot also drops out with engine trouble.","q":false},{"lap":1,"text":"Baras leads after the first lap, ahead of Duray and Szisz.","q":false,"c":6},{"lap":2,"text":"During the 2nd lap Baron de Caters (8C Itala) landed with his Itala in a ditch at St. Calais and injured his arm.","q":true,"src":"goldenera.fi","c":27},{"lap":2,"text":"Baras still leads on lap two.","q":false,"c":6},{"lap":3,"text":"Szisz takes the lead with the detachable-rim Renault; the Brasiers of Barillier and Baras follow.","q":false,"c":0},{"lap":3,"text":"When Cagno (8A Itala) stopped with a stone-damaged radiator, all Italas were out after only two laps racing.","q":true,"src":"goldenera.fi","c":26},{"lap":3,"text":"Wagner retires with broken valves.","q":false,"c":25},{"lap":4,"text":"Edmond (3B Renault) also stopped at the depot on completion of his third circuit, grit having found its way into the water circulation.","q":true,"src":"goldenera.fi","c":17},{"lap":4,"text":"During the 4th lap de la Touloubre (13C Bayard-Cl\u00e9ment) went out with a broken gearbox.","q":true,"src":"goldenera.fi","c":23},{"lap":4,"text":"Szisz leads; Teste, Shepard, Baras and Nazzaro follow.","q":false,"c":0},{"lap":5,"text":"Tart gives up with a broken frame on his Panhard.","q":false,"c":22},{"lap":5,"text":"Edmond, unable to see the road, withdraws a few miles short of the line.","q":false,"c":17},{"lap":5,"text":"When H\u00e9mery (4A Darracq) in 15th place and already one lap behind, completed his fifth lap, the commissioners stopped him as they believed he had completed his first day tour.","q":true,"src":"goldenera.fi","c":13},{"lap":6,"text":"Weill-Schott (2C (F.I.A.T.) lost his third place when his car spun and rolled on a wooden board section around Vibraye which ended his battle.","q":true,"src":"goldenera.fi","c":20},{"lap":6,"text":"At the end of lap six, just before noon, Szisz in first place acknowledged the yellow flag after 5h45m30.4s.","q":true,"src":"goldenera.fi","c":0},{"lap":6,"text":"End of day one: Cl\u00e9ment second, over 26 minutes back, Nazzaro third. The cars go into parc ferm\u00e9 overnight.","q":false},{"lap":7,"text":"Two additional mechanics had permission to restart the engine of each car and Szisz headed straight to his pits where he spent the next 12 minutes to fit new tires and top up the essential fluids.","q":true,"src":"goldenera.fi","c":0},{"lap":7,"text":"Burton takes over Jenatzy's Mercedes for the second day.","q":false,"c":9},{"lap":7,"text":"Teste (10 C Panhard) crashed spectacularly at La Fourche hairpin caused by a broken spring hanger.","q":true,"src":"goldenera.fi","c":16},{"lap":8,"text":"Shepard (12C Hotchkiss) ran over the banking at La Fourche, broke a wheel and overturned without getting injured.","q":true,"src":"goldenera.fi","c":15},{"lap":8,"text":"Rigolly (7A Gobron-Brill\u00e9) retired on the 8th lap with a burst radiator.","q":true,"src":"goldenera.fi","c":14},{"lap":9,"text":"Richez (3C Renault) crashed at La Fourche hairpin and retired.","q":true,"src":"goldenera.fi","c":12},{"lap":10,"text":"Nazzaro advanced into second position and pushed Cl\u00e9ment to third place.","q":true,"src":"goldenera.fi","c":1},{"lap":11,"text":"Burton loses more time with tyre changes; a stone injures his eye.","q":false,"c":9},{"lap":12,"text":"After 12h14m07s, the red Renault of Szisz was first to cross the finish line, which was confirmed by the trumpet signal.","q":true,"src":"goldenera.fi","c":0},{"lap":12,"text":"Nazzaro (2B F.I.A.T.) arrived 32m19.4s behind in second place and Albert Cl\u00e9ment (13A Bayard-Cl\u00e9ment) followed only 3m20.4s behind","q":true,"src":"goldenera.fi","c":1}]}