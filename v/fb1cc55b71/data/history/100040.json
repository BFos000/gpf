31,32],[3,6,7,8,9,11,13,14,16,17,18,19,21,22,23]],"pit":[[[24,148000,"data"],[31,80000,"data"]],[[20,150000,"data"],[25,null,"data"]],[[11,198000,"data"],[14,110000,"data"],[36,135000,"data"],[40,45000,"data"],[44,60000,"data"]],[[9,371000,"data"],[18,150000,"data"],[29,215000,"data"]],[[25,220000,"data"],[26,135000,"data"],[27,140000,"data"]],[[5,530000,"data"],[21,513000,"data"]],[[22,230000,"data"]]],"sc":[],"vsc":[],"red":[],"fl":null,"best":[],"xl":[],"bx":[],"s0":[0,0,0,0,240000,0,0],"nar":[{"lap":0,"text":"Bugatti withdraws shortly before the start; seven cars line up.","q":false},{"lap":1,"text":"Divo takes the lead with Benoist on his heels; Wagner's Talbot refuses to start and is delayed more than four minutes.","q":false,"c":6},{"lap":1,"text":"Divo, Benoist and Williams complete the first lap in a close group, nine seconds ahead of Bourlier and Morel.","q":false,"c":6},{"lap":2,"text":"On the second lap Divo, the French Champion, drove a fast lap in 5m57s at an average speed of 126.050 km/h.","q":true,"src":"goldenera.fi","c":6},{"lap":4,"text":"On lap 4 Benoist succeeded in passing Divo, while Williams passed his teammate for second place","q":true,"src":"goldenera.fi","c":0},{"lap":4,"text":"Wagner laps in 5m56s and overhauls Eyston.","q":false,"c":4},{"lap":5,"text":"On lap five Eyston stopped at his pit for 8m50s to change spark plugs.","q":true,"src":"goldenera.fi","c":5},{"lap":5,"text":"Williams, who tried to get past Benoist on lap 5, drove a new fast lap in 5m44s at 130.813 km/h average speed.","q":true,"src":"goldenera.fi","c":3},{"lap":10,"text":"Benoist laps in 5m41s at 131.964 km/h, a new Montlh\u00e9ry lap record.","q":false,"c":0},{"lap":10,"text":"Williams pits for 6m11s with a fuel feed problem and four new wheels, dropping from second to sixth.","q":false,"c":3},{"lap":12,"text":"After lap 11 Morel stopped his Delage at the pit for 3m18s.","q":true,"src":"goldenera.fi","c":2},{"lap":15,"text":"Benoist finished the 15 laps in 1h27m at 129.310 km/h average speed, leading Divo by 1m25 s with Bourlier 1m49s further back.","q":true,"src":"goldenera.fi","c":0},{"lap":16,"text":"On lap 16 Morel spun completely around at Bailleau but carried on undisturbed.","q":true,"src":"goldenera.fi","c":2},{"lap":20,"text":"After 20 laps Bourlier stopped his Delage for 2m30s to refuel and change two wheels and spark plugs.","q":true,"src":"goldenera.fi","c":1},{"lap":22,"text":"Divo stops 3m50s with a punctured tyre and is passed by Bourlier.","q":false,"c":6},{"lap":23,"text":"Divo pits again; the Talbot refuses to start even after new plugs and a push, and he retires.","q":false,"c":6},{"lap":24,"text":"On lap 24 Benoist stopped at the pits to refuel and to change four wheels in 2m28s.","q":true,"src":"goldenera.fi","c":0},{"lap":26,"text":"Wagner keeps third despite stops for fuel and then water.","q":false,"c":4},{"lap":29,"text":"Williams stops 3m35s for four wheels and hands over to Moriceau.","q":false,"c":3},{"lap":31,"text":"At the end of lap 31 Benoist who had just equaled his record lap of 5m41s, stopped for 1m20s at his pit to replace a spark plug and fill up with fuel.","q":true,"src":"goldenera.fi","c":0},{"lap":40,"text":"Bourlier was second one lap behind, followed by Wagner and Morel both two laps behind with Moriceau in fifth place six laps behind and Eyston last 12 laps behind.","q":true,"src":"goldenera.fi","c":1},{"lap":43,"text":"Wagner stops out on the circuit with magneto failure and retires; the three Delages run one-two-three.","q":false,"c":4},{"lap":48,"text":"Benoist wins in record time, with Bourlier and Morel completing a Delage one-two-three; Moriceau's Talbot is fourth.","q":false,"c":0}]}