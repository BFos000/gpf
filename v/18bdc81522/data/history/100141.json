,[[22,170000,"data"]],[],[],[[8,null,"data"]],[],[],[[2,null,"data"]],[],[],[],[]],"sc":[],"vsc":[],"red":[],"fl":null,"best":[],"xl":[],"bx":[],"nar":[{"lap":0,"text":"Lehoux takes pole, with the Maseratis of Campari and Zehender alongside.","q":false,"c":6},{"lap":1,"text":"Lehoux and Zehender made the best start, followed by Moll and Sommer.","q":true,"src":"goldenera.fi","c":6},{"lap":1,"text":"By the end of the first lap Lehoux in the Bugatti was in the lead, followed by the Alfa Romeos of Nuvolari, who was already in second place, then Moll, Wimille and F\u00e9lix, then Zehender's Maserati.","q":true,"src":"goldenera.fi","c":6},{"lap":2,"text":"On lap two Nuvolari went into the lead, Lehoux was second, followed by Etancelin.","q":true,"src":"goldenera.fi","c":5},{"lap":3,"text":"Nuvolari laps in 3m05s and leads Lehoux by 10 seconds.","q":false,"c":5},{"lap":3,"text":"Jellen again stopped at his pit and retired the Alfa Romeo.","q":true,"src":"goldenera.fi","c":12},{"lap":4,"text":"On lap four Nuvolari was already 14s ahead of Campari who had passed Lehoux for second place; Etancelin was fourth.","q":true,"src":"goldenera.fi","c":9},{"lap":5,"text":"Villars retired his Alfa with a leaking oil reservoir.","q":true,"src":"goldenera.fi","c":10},{"lap":7,"text":"On lap seven Nuvolari was 21s ahead of Campari, followed by Lehoux and Etancelin.","q":true,"src":"goldenera.fi","c":5},{"lap":9,"text":"Campari retires at his pit after a stone hits his face.","q":false,"c":9},{"lap":10,"text":"After 10 laps Nuvolari led with 31m28s, an average speed of 149.224 km/h. The order behind him was Lehoux, Etancelin, Zehender, Pietsch and Moll.","q":true,"src":"goldenera.fi","c":5},{"lap":12,"text":"Zehender retired on lap 12 also after being hit by a stone in the face.","q":true,"src":"goldenera.fi","c":7},{"lap":15,"text":"Lehoux stops; Etancelin moves up to second, 1m02s behind Nuvolari.","q":false,"c":0},{"lap":18,"text":"On lap 18 Etancelin had reduced his gap to Nuvolari to 55s. Wimille in third place was 1m59s behind Nuvolari and Moll was fourth.","q":true,"src":"goldenera.fi","c":0},{"lap":20,"text":"After 20 laps Nuvolari led Etancelin by 50s, followed by Wimille, Moll and Straight.","q":true,"src":"goldenera.fi","c":5},{"lap":22,"text":"Nuvolari stops for fuel and tyres; the slow 2m50s stop drops him to fourth behind Etancelin, Wimille and Moll.","q":false,"c":5},{"lap":24,"text":"Moll passes Wimille for second, 1m30s behind Etancelin; Nuvolari is 2m27s back in fourth.","q":false,"c":4},{"lap":25,"text":"After 25 laps Etancelin led the race with an average speed of 145.8 km/h, chased by Moll, Wimille and Nuvolari.","q":true,"src":"goldenera.fi","c":0},{"lap":28,"text":"The Italian made up more time and on lap 28 he was only 1m58s behind Etancelin, having gained 29 seconds within five laps.","q":true,"src":"goldenera.fi","c":5},{"lap":29,"text":"Nuvolari soon moved into third place past Wimille who had to top up with fuel.","q":true,"src":"goldenera.fi","c":5},{"lap":29,"text":"Lehoux, several laps down with a transmission defect, finally gives up.","q":false,"c":6},{"lap":30,"text":"After 30 laps Etancelin leads Moll by 1m42s, Nuvolari by 1m48s and Wimille by 2m37s.","q":false,"c":0},{"lap":31,"text":"On lap 31 Nuvolari passed Moll for second place but was still 1m46s behind Etancelin.","q":true,"src":"goldenera.fi","c":5},{"lap":32,"text":"Nuvolari is out: the Alfa's back axle final drive breaks at Gueux corner.","q":false,"c":5},{"lap":40,"text":"After 40 laps Etancelin was 2m26s ahead of Moll and 2m47s of Wimille.","q":true,"src":"goldenera.fi","c":0},{"lap":42,"text":"Etancelin stops 1m55s for fuel and rear wheels; Moll takes the lead.","q":false,"c":0},{"lap":45,"text":"Etancelin is 16 seconds behind Moll and closing.","q":false,"c":0},{"lap":48,"text":"On lap 48 Etancelin came past the grandstand in first place, pursued by Wimille less than four seconds behind. Then Moll arrived at his pit and stopped for 40 seconds to refuel.","q":true,"src":"goldenera.fi","c":0},{"lap":51,"text":"On the last lap Wimille attacked the leader several times but Etancelin defended his position well.","q":true,"src":"goldenera.fi","c":1},{"lap":51,"text":"Etancelin prevailed as the deserved victor with a gap of only 1/5 second ahead of Wimille, while Moll in third place was disqualified because of a rules violation.","q":true,"src":"goldenera.fi","c":0}]}