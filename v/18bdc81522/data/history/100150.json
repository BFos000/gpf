]],[[17,null,"data"],[31,null,"report"],[40,null,"data"],[48,null,"data"]],[],[],[],[],[],[],[],[],[],[],[],[[22,null,"data"],[26,null,"data"],[40,null,"data"]],[],[[18,null,"data"]],[],[],[]],"sc":[],"vsc":[],"red":[],"fl":null,"best":[],"xl":[],"bx":[],"nar":[{"lap":0,"text":"The circuit was still wet but drying at the time of the 9:30 AM start.","q":true,"src":"goldenera.fi"},{"lap":0,"text":"Ernesto Maserati did not make the start and his place on row three was left vacant.","q":true,"src":"goldenera.fi"},{"lap":1,"text":"Siena in the red Alfa Romeo had the initial lead, behind him came Nuvolari in the red-yellow Maserati and Taruffi both in Maserati monopostos.","q":true,"src":"goldenera.fi","c":4},{"lap":1,"text":"Nuvolari was the first to finish lap one, closely followed by Fagioli with his red Alfa Romeo monoposto, then Taruffi, Premoli, Chiron and Zehender.","q":true,"src":"goldenera.fi","c":1},{"lap":2,"text":"On the next lap Fagioli caught up with Nuvolari in front of the grandstands where he made his pass to enthusiastic shouts by the crowd.","q":true,"src":"goldenera.fi","c":0},{"lap":5,"text":"The leading group consisted of Fagioli and Nuvolari who were fighting closely after 17m22s, ahead of Taruffi, Chiron and Zehender. Then was a long gap to the rest.","q":true,"src":"goldenera.fi"},{"lap":5,"text":"Premoli had already retired with his PBM.","q":true,"src":"goldenera.fi","c":18},{"lap":6,"text":"Nuvolari had again overtaken his dangerous opponent. It took only one lap for Fagioli to regain the lost lead.","q":true,"src":"goldenera.fi","c":1},{"lap":8,"text":"Nuvolari is in front again.","q":false,"c":1},{"lap":9,"text":"On the ninth lap the Mantuan's lead was assured as Fagioli stopped at his pit for a quick refuel of his car.","q":true,"src":"goldenera.fi","c":0},{"lap":10,"text":"After ten laps Nuvolari led with 34m10.4s ahead of Taruffi, Chiron and Zehender. Fagioli had now fallen to fifth place","q":true,"src":"goldenera.fi","c":1},{"lap":11,"text":"On lap 11, the young Taruffi, who for some time had followed the leader closely, dashed past Nuvolari, only to be relegated to second place by the Mantuan on the following lap.","q":true,"src":"goldenera.fi","c":15},{"lap":15,"text":"After 15 laps, Nuvolari was leading Taruffi and Chiron at 51m18.4s. Fagioli by now had made it past Zehender into fourth place.","q":true,"src":"goldenera.fi","c":1},{"lap":17,"text":"After 17 laps Nuvolari, waving his hand, screeched into his pit with one flat tire, to change one rear wheel in unbelievably short time. But the stop dropped him to fourth position.","q":true,"src":"goldenera.fi","c":1},{"lap":18,"text":"On lap 18 another change took place when Taruffi stopped at his pit and Chiron became the new leader.","q":true,"src":"goldenera.fi","c":13},{"lap":19,"text":"Nuvolari finished the nineteenth lap with an average of 184.9 km/h and had worked himself into second place only 18 seconds behind Chiron.","q":true,"src":"goldenera.fi","c":1},{"lap":20,"text":"Taruffi pits to have loose wheels hammered tight; Zehender also stops.","q":false,"c":15},{"lap":22,"text":"On lap 22 Chiron changed one wheel at frantic speed, which enabled Fagioli to get past him but very soon the Monegasque was back in the lead.","q":true,"src":"goldenera.fi","c":13},{"lap":24,"text":"Brivio's Monza is out.","q":false,"c":14},{"lap":25,"text":"On lap 25 Taruffi got into another huge slide, this time in Curva Grande and hit the inside wall without any harm to him.","q":true,"src":"goldenera.fi","c":15},{"lap":26,"text":"On lap 26 Chiron stopped for fuel and changed all four wheels. Although this work was carried out in an unbelievably fast time, Fagioli and Nuvolari went past","q":true,"src":"goldenera.fi","c":13},{"lap":27,"text":"Fagioli pits for fuel and wheels; Nuvolari takes the lead, Chiron moves up to second.","q":false,"c":0},{"lap":30,"text":"At the end of 30 laps Nuvolari held the lead with 1h48m49.2s. Chiron followed almost 2 minutes behind","q":true,"src":"goldenera.fi","c":1},{"lap":31,"text":"Nuvolari pits to refuel and change front wheels; Chiron takes the lead. Brivio takes over Siena's Monza.","q":false,"c":13},{"lap":35,"text":"After 35 laps Chiron had built up a two minute advantage to Nuvolari, who was followed by Fagioli, Zehender and Lehoux.","q":true,"src":"goldenera.fi","c":13},{"lap":40,"text":"Lap 40 brought new life into the monotonous race when Chiron and Nuvolari both stopped at the pits. The first to change plugs, the second for another wheel change.","q":true,"src":"goldenera.fi"},{"lap":41,"text":"One lap later Chiron slowly motored around, his race over with a broken valve in the Alfa's engine.","q":true,"src":"goldenera.fi","c":13},{"lap":48,"text":"Nuvolari pits with a blown tyre; Fagioli thunders past into the lead.","q":false,"c":1},{"lap":50,"text":"After 50 laps Race Director Renzo Castagnetto waved off Fagioli as the victor.","q":true,"src":"goldenera.fi","c":0},{"lap":50,"text":"Nuvolari came second with a gap of 40 seconds, Zehender third, then Lehoux.","q":true,"src":"goldenera.fi"}]}